# Copy to apps/api/.env (preferred) or the repo root.
# Prefix CRYPTOAI_ is required. Restart `npm run dev` after changes.
# Confidence threshold is hardcoded at 75 (variant A) — not an env flag.

CRYPTOAI_APP_NAME=CryptoAI Trader
CRYPTOAI_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT"]
CRYPTOAI_STARTING_BALANCE=10000
CRYPTOAI_TAKER_FEE=0.0005
CRYPTOAI_SLIPPAGE=0.0002
CRYPTOAI_MAX_RISK_PER_TRADE=0.015
CRYPTOAI_MAX_DAILY_DRAWDOWN=0.03
CRYPTOAI_SIGNAL_TIMEFRAME=5m
CRYPTOAI_CHART_TIMEFRAME=1m
CRYPTOAI_BINANCE_REST=https://api.binance.com
CRYPTOAI_BINANCE_WS=wss://stream.binance.com:443/stream
CRYPTOAI_DB_PATH=paper.db
CRYPTOAI_BOOT_BINANCE=true
